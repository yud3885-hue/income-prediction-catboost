            "  native_country (object)\n",
            "  cap_net (int64)\n",
            "  has_capital_stats (int64)\n",
            "  gain_per_hour (float64)\n",
            "  age_bins (object)\n",
            "  sex_marital (object)\n",
            "  edu_occ (object)\n",
            "  occupation_te (float64)\n",
            "  native_country_te (float64)\n",
            "  edu_occ_te (float64)\n",
            "  sex_marital_te (float64)\n",
            "  workclass_te (float64)\n",
            "  occupation_mean_age (float64)\n",
            "  occupation_mean_education_num (float64)\n",
            "  occupation_mean_hours_per_week (float64)\n",
            "  native_country_mean_education_num (float64)\n",
            "  native_country_mean_hours_per_week (float64)\n",
            "  workclass_mean_age (float64)\n",
            "  workclass_mean_hours_per_week (float64)\n"
          ]
        }
      ],
      "source": [
        "# 범주형 피처 자동 인식\n",
        "cat_features = X.select_dtypes(include=['object']).columns.tolist()\n",
        "print('범주형 컬럼 수:', len(cat_features))\n",
        "print('수치형 컬럼 수:', X.shape[1] - len(cat_features))\n",
        "print('\\n전체 컬럼:')\n",
        "for c in X.columns:\n",
        "    print(f'  {c} ({X[c].dtype})')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "5HhInA2SFH-p"
      },
      "source": [
        "## 5. 데이터 분할 (단일 train/val split)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hXBxNjePFH-p",
        "outputId": "e0c19ed0-7985-4b1b-f05c-1f4fc1a23b1a"
      },
