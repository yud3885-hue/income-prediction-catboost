    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ePjO1aNUFH-m",
        "outputId": "3606e8bc-e860-45f8-a9fa-9cd1c521288e"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Train shape: (39073, 15)\n",
            "Test shape: (9769, 14)\n"
          ]
        }
      ],
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split, KFold\n",
        "from sklearn.metrics import f1_score, roc_auc_score\n",
        "from catboost import CatBoostClassifier\n",
        "\n",
        "\n",
        "TRAIN_PATH = '/content/drive/MyDrive/Colab Notebooks/Pattern/train.xlsx'\n",
        "TEST_PATH = '/content/drive/MyDrive/Colab Notebooks/Pattern/test.xlsx'\n",
        "USE_EXCEL = True\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "# 1. 데이터 로드\n",
        "if USE_EXCEL:\n",
        "    train_df = pd.read_excel(TRAIN_PATH)\n",
        "    test_df = pd.read_excel(TEST_PATH)\n",
        "else:\n",
        "    train_df = pd.read_csv(TRAIN_PATH)\n",
        "    test_df = pd.read_csv(TEST_PATH)\n",
        "\n",
        "print('Train shape:', train_df.shape)\n",
        "print('Test shape:', test_df.shape)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "MVdXeUs3FH-m"
      },
      "source": [
        "## 2. Base Feature Engineering"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "COhqX2OkFH-n",
        "outputId": "0bbb114a-5126-46d0-e915-91e42e5d4982"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Base FE 적용 후: (39073, 19) | (9769, 19)\n"
          ]
        }
      ],
      "source": [
        "def base_engineering(df):\n",
        "    \"\"\"TalkFile 원본 6개 feature (baseline)\"\"\"\n",
        "    df = df.copy()\n",
        "    df = df.replace(r'^\\s*\\?\\s*$', 'Unknown', regex=True)\n",
        "    for col in df.select_dtypes(include='object').columns:\n",
        "        df[col] = df[col].astype(str).str.strip()\n",
        "\n",
        "    df['cap_net'] = df['capital_gain'] - df['capital_loss']\n",
        "    df['has_capital_stats'] = ((df['capital_gain'] > 0) | (df['capital_loss'] > 0)).astype(int)\n",
        "    df['gain_per_hour'] = df['capital_gain'] / (df['hours_per_week'] + 1)\n",
        "    df['age_bins'] = pd.cut(\n",
        "        df['age'], bins=[0, 25, 35, 45, 60, 100],\n",
        "        labels=['Young', 'Junior', 'Senior', 'Veteran', 'Retired']\n",
        "    ).astype(str)\n",
        "    df['sex_marital'] = df['sex'].astype(str) + '_' + df['marital_status'].astype(str)\n",
        "    df['edu_occ'] = df['education'].astype(str) + '_' + df['occupation'].astype(str)\n",
        "\n",
        "    cat_cols = df.select_dtypes(include=['object']).columns\n",
        "    for col in cat_cols:\n",
        "        df[col] = df[col].fillna('Unknown').astype(str)\n",
        "    return df\n",
        "\n",
        "y = (train_df['income'].astype(str).str.strip() == '>50K').astype(int)\n",
        "test_ids = test_df['id']\n",
        "\n",
        "X = base_engineering(train_df.drop(columns=['income', 'id']))\n",
        "X_test = base_engineering(test_df.drop(columns=['id']))\n",
        "\n",
        "print('Base FE 적용 후:', X.shape, '|', X_test.shape)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "v8sBojjWFH-n"
      },
      "source": [
        "## 3.Target Encoding (KFold OOF) — 누수 방지\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "c3ojVcaWFH-n",
        "outputId": "745411f8-8066-4e7e-e483-b34b794e62b2"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "  occupation_te 추가됨 (train mean=0.2393, test mean=0.2380)\n",
            "  native_country_te 추가됨 (train mean=0.2395, test mean=0.2394)\n",
            "  edu_occ_te 추가됨 (train mean=0.2414, test mean=0.2404)\n",
            "  sex_marital_te 추가됨 (train mean=0.2395, test mean=0.2372)\n",
            "  workclass_te 추가됨 (train mean=0.2390, test mean=0.2407)\n",
            "\n",
            "Target Encoding 후: X=(39073, 24), X_test=(9769, 24)\n"
          ]
        }
      ],
      "source": [
        "def kfold_target_encode(train_series, target, test_series, n_splits=5, smoothing=10, random_state=42):\n",
        "    \"\"\"\n",
        "    KFold target encoding (out-of-fold) — 누수 방지.\n",
        "\n",
        "    Args:\n",
        "        train_series: 범주형 train 값 (pd.Series)\n",
        "        target: y_train (pd.Series)\n",
        "        test_series: 범주형 test 값\n",
        "        n_splits: KFold 수 (보통 5)\n",
        "        smoothing: 적은 샘플 카테고리에 global mean 영향력 (높을수록 보수적)\n",
        "\n",
        "    Returns:\n",
        "        encoded_train, encoded_test\n",
        "    \"\"\"\n",
        "    kf = KFold(n_splits=n_splits, shuffle=True, random_state=random_state)\n",
        "    global_mean = target.mean()\n",
        "    encoded_train = pd.Series(index=train_series.index, dtype=float)\n",
        "\n",
        "    # Train: OOF 인코딩\n",
        "    for train_idx, val_idx in kf.split(train_series):\n",
        "        fold_train_x = train_series.iloc[train_idx]\n",
        "        fold_train_y = target.iloc[train_idx]\n",
        "\n",
        "        agg = fold_train_y.groupby(fold_train_x).agg(['mean', 'count'])\n",
        "        # Smoothed mean: 적은 count의 카테고리는 global_mean으로 끌림\n",
        "        smooth = (agg['mean'] * agg['count'] + global_mean * smoothing) / (agg['count'] + smoothing)\n",
        "\n",
        "        encoded_train.iloc[val_idx] = train_series.iloc[val_idx].map(smooth).fillna(global_mean).values\n",
        "\n",
        "    # Test: 전체 train으로 인코딩\n",
        "    agg_full = target.groupby(train_series).agg(['mean', 'count'])\n",
        "    smooth_full = (agg_full['mean'] * agg_full['count'] + global_mean * smoothing) / (agg_full['count'] + smoothing)\n",
        "    encoded_test = test_series.map(smooth_full).fillna(global_mean)\n",
        "\n",
        "    return encoded_train, encoded_test\n",
        "\n",
        "# 고카디널리티 범주형에 target encoding 적용\n",
        "te_cols = ['occupation', 'native_country', 'edu_occ', 'sex_marital', 'workclass']\n",
        "\n",
        "for col in te_cols:\n",
        "    enc_train, enc_test = kfold_target_encode(\n",
        "        X[col], y, X_test[col],\n",
        "        n_splits=5, smoothing=10, random_state=RANDOM_STATE\n",
        "    )\n",
        "    X[f'{col}_te'] = enc_train.values\n",
        "    X_test[f'{col}_te'] = enc_test.values\n",
        "    print(f'  {col}_te 추가됨 (train mean={enc_train.mean():.4f}, test mean={enc_test.mean():.4f})')\n",
        "\n",
        "print(f'\\nTarget Encoding 후: X={X.shape}, X_test={X_test.shape}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "AGIvEYvFFH-o"
      },
      "source": [
        "## 4. Group Aggregation Features\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "xlc9uRluFH-o",
        "outputId": "be578724-ceaf-4dce-f84f-db1246d13a29"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "  occupation별 ['age', 'education_num', 'hours_per_week'] 평균 추가됨\n",
            "  native_country별 ['education_num', 'hours_per_week'] 평균 추가됨\n",
            "  workclass별 ['age', 'hours_per_week'] 평균 추가됨\n",
            "\n",
            "Group Aggregation 후: X=(39073, 31), X_test=(9769, 31)\n",
            "총 컬럼: 31개\n"
          ]
        }
      ],
      "source": [
        "def add_group_aggregations(train_df, test_df, group_col, num_cols):\n",
        "    \"\"\"\n",
        "    그룹별 평균을 train_df, test_df에 새 컬럼으로 추가 (train 통계 기반).\n",
        "\n",
        "    Args:\n",
        "        train_df, test_df: 변환할 dataframe\n",
        "        group_col: 그룹화 기준 (예: 'occupation')\n",
        "        num_cols: 평균을 구할 수치형 컬럼들\n",
        "    \"\"\"\n",
        "    # Train에서만 통계 계산\n",
        "    group_stats = train_df.groupby(group_col)[num_cols].mean()\n",
        "\n",
        "    for col in num_cols:\n",
        "        new_col = f'{group_col}_mean_{col}'\n",
        "        train_df[new_col] = train_df[group_col].map(group_stats[col])\n",
        "        test_df[new_col] = test_df[group_col].map(group_stats[col])\n",
        "        # test에 없는 카테고리 발생 시 train global mean으로 채움\n",
        "        global_mean = train_df[col].mean()\n",
        "        train_df[new_col] = train_df[new_col].fillna(global_mean)\n",
        "        test_df[new_col] = test_df[new_col].fillna(global_mean)\n",
        "\n",
        "    return train_df, test_df\n",
        "\n",
        "# 적용\n",
        "agg_specs = [\n",
        "    ('occupation',     ['age', 'education_num', 'hours_per_week']),\n",
        "    ('native_country', ['education_num', 'hours_per_week']),\n",
        "    ('workclass',      ['age', 'hours_per_week']),\n",
        "]\n",
        "\n",
        "for group_col, num_cols in agg_specs:\n",
        "    X, X_test = add_group_aggregations(X, X_test, group_col, num_cols)\n",
        "    print(f'  {group_col}별 {num_cols} 평균 추가됨')\n",
        "\n",
        "print(f'\\nGroup Aggregation 후: X={X.shape}, X_test={X_test.shape}')\n",
        "print(f'총 컬럼: {X.shape[1]}개')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "yXukYDq8FH-p",
        "outputId": "e3558275-0d99-492d-e0e1-6b2ce03ca3ec"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
