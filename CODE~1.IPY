            "수치형 컬럼 수: 20\n",
            "\n",
            "전체 컬럼:\n",
            "  age (int64)\n",
            "  workclass (object)\n",
            "  education (object)\n",
            "  education_num (int64)\n",
            "  marital_status (object)\n",
            "  occupation (object)\n",
