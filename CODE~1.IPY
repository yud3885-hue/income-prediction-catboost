      ],
      "source": [
        "model = CatBoostClassifier(\n",
        "    iterations=2500,\n",
        "    learning_rate=0.02,\n",
        "    depth=7,\n",
        "    l2_leaf_reg=10,\n",
        "    bagging_temperature=0.8,\n",
        "    random_strength=1,\n",
        "    border_count=254,\n",
        "    random_seed=RANDOM_STATE,\n",
        "    cat_features=cat_features,\n",
        "    early_stopping_rounds=200,\n",
        "    verbose=200\n",
        ")\n",
        "\n",
        "model.fit(X_train, y_train, eval_set=(X_val, y_val), use_best_model=True)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "CGa5j3VCFH-q"
      },
      "source": [
        "## 7. Threshold 최적화"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 10,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "bNQX6lQiFH-r",
        "outputId": "feae5b3d-d95f-4501-e49a-20a88395022b"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "==================================================\n",
            "최적 Threshold: 0.4220\n",
            "검증 AUC: 0.9306\n",
            "검증 F1: 0.7373\n",
            "최종 Target ((F1+AUC)/2): 0.8339\n",
            "==================================================\n"
          ]
        }
      ],
      "source": [
        "val_probs = model.predict_proba(X_val)[:, 1]\n",
        "auc_score = roc_auc_score(y_val, val_probs)\n",
        "\n",
        "best_threshold = 0.5\n",
        "best_metric = -1\n",
        "\n",
        "for th in np.linspace(0.1, 0.8, 701):\n",
        "    val_preds = (val_probs >= th).astype(int)\n",
        "    f1 = f1_score(y_val, val_preds)\n",
        "    current_metric = (f1 + auc_score) / 2\n",
        "    if current_metric > best_metric:\n",
        "        best_metric = current_metric\n",
        "        best_threshold = th\n",
        "\n",
        "print('\\n' + '=' * 50)\n",
        "print(f'최적 Threshold: {best_threshold:.4f}')\n",
        "print(f'검증 AUC: {auc_score:.4f}')\n",
        "print(f'검증 F1: {f1_score(y_val, (val_probs >= best_threshold).astype(int)):.4f}')\n",
        "print(f'최종 Target ((F1+AUC)/2): {best_metric:.4f}')\n",
        "print('=' * 50)"
      ]
    },
